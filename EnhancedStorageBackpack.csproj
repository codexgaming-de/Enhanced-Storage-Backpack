<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>EnhancedStorageBackpack</AssemblyName>
    <Version>0.0.5</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <MelonLoaderDirectory Condition="'$(MelonLoaderDirectory)' == ''">$(GameDirectory)/MelonLoader/net6</MelonLoaderDirectory>
    <GameAssembliesDirectory Condition="'$(GameAssembliesDirectory)' == ''">$(GameDirectory)/MelonLoader/Il2CppAssemblies</GameAssembliesDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Reference Include="MelonLoader">
      <HintPath>$(MelonLoaderDirectory)/MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameAssembliesDirectory)/*.dll"><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MelonLoaderDirectory)/Il2CppInterop.Runtime.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MelonLoaderDirectory)/0Harmony.dll</HintPath><Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckMelonLoaderReference" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(MelonLoaderDirectory)/MelonLoader.dll')" Text="MelonLoader.dll fehlt. Bitte -p:GameDirectory=&quot;/vollstaendiger/Pfad/Schedule I&quot; angeben." />
    <Error Condition="!Exists('$(GameAssembliesDirectory)/UnityEngine.CoreModule.dll')" Text="UnityEngine.CoreModule.dll fehlt in MelonLoader/Il2CppAssemblies. Bitte den Spielpfad pruefen und MelonLoader einmal starten." />
  </Target>
</Project>
